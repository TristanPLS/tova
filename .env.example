# TOVA — variables d'environnement (VALEURS FACTICES — ne jamais committer de vraie valeur).
# Copier en .env (git-ignore) pour le developpement local.

# --- Noeud d'urne (tova-node) — pertinent a partir du jalon J4 ---
# Adresse d'ecoute du serveur d'urne.
TOVA_NODE_BIND=127.0.0.1:8080
# Index SQLite (le registre Merkle reste la source de verite, pas la base).
TOVA_DB_PATH=./data/tova.sqlite
# Identifiant unique du scrutin (domain-separation des key images entre scrutins).
TOVA_ELECTION_ID=<remplacer-par-un-id-de-scrutin>

# --- Garants / dechiffrement a seuil (tova-cli) — jalon J3+ ---
# Chemin de la part de cle d'un garant. A STOCKER HORS DEPOT. Perte de > n-t parts = election indechiffrable.
TOVA_GUARDIAN_SHARE_PATH=<remplacer-chemin-hors-depot>

# --- Temoins / non-equivocation (witnesses) — jalon J5 ---
# URLs des temoins independants co-signant les Signed Tree Heads (separees par des virgules).
TOVA_WITNESS_URLS=https://witness-1.example,https://witness-2.example
